# Copy to .env. Never commit the filled-in file: these are live credentials.

# --- Meta app (shared by both products) ---
META_APP_SECRET=
# Any random string. You type the same value into the webhook setup screen in the Meta dashboard.
META_VERIFY_TOKEN=
GRAPH_VERSION=v21.0

# --- Instagram (professional account linked to a Facebook page) ---
IG_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_DAILY_PUBLISH_LIMIT=50

# --- WhatsApp Cloud API ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_REENGAGEMENT_TEMPLATE=lead_follow_up
WA_TEMPLATE_LANGUAGE=en

# --- This service ---
PORT=8080
PUBLIC_URL=https://cascade.example.com
DATABASE_PATH=./cascade.db
# Shared secret n8n sends as x-cascade-key. Generate with: openssl rand -hex 32
CASCADE_API_KEY=
