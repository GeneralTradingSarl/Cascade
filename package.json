  "license": "MIT",
  "homepage": "https://github.com/GeneralTradingSarl/Cascade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeneralTradingSarl/Cascade.git"
  },
  "bugs": {
    "url": "https://github.com/GeneralTradingSarl/Cascade/issues"
  },
  "keywords": [
    "instagram-api",
    "instagram-graph-api",
    "whatsapp",
    "whatsapp-cloud-api",
    "n8n",
    "automation",
    "marketing-automation",
    "lead-generation",
